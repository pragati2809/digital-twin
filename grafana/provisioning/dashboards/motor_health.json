      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
          "query": "from(bucket: \"machine_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => (r._measurement == \"telemetry\" and r._field == \"label\") or (r._measurement == \"health\" and r._field == \"predicted_failure\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)",
          "refId": "A"
