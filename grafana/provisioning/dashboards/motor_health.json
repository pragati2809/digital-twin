      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB_Flux" },
          "query": "from(bucket: \"machine_data\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"air_temp\" or r._field == \"process_temp\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
