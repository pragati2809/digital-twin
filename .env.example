# Copy to .env and change the secrets before deploying. docker compose reads .env automatically.

# MQTT broker (used by scripts run outside Docker)
MQTT_HOST=localhost
MQTT_PORT=1883

# InfluxDB (org and bucket are also referenced by the Grafana provisioning files)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me-to-a-long-random-token
INFLUX_ORG=digital-twin-org
INFLUX_BUCKET=machine_data
INFLUX_ADMIN_PASSWORD=change-me-influx-password

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Logical machine name stored as an InfluxDB tag
MACHINE_ID=bearing_de_01

# Streamlit: 1 = auto-refresh Live Monitor by default
AUTO_REFRESH=1
